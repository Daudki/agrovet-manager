# Copy to .env and adjust. Never commit the real .env file.

# Port the API (and, in production, the built web app) listens on
PORT=4000

# REQUIRED in production – a long random string used to sign login sessions.
#   openssl rand -hex 32
JWT_SECRET=

# SQLite database file (relative paths are resolved from the repository root)
DATABASE_PATH=server/data/agrovet.db

# Session length in days
SESSION_DAYS=7

# Set to "true" when serving over HTTPS (default: true when NODE_ENV=production).
# Use "false" only if you test a production build over plain http://localhost.
# COOKIE_SECURE=true

# Number of reverse proxies in front of the app (so rate limiting sees real client IPs).
# TRUST_PROXY=1

# Platform admin panel at /admin (just for you). Leave both empty to disable it.
#   npm run admin:hash      → prints the ADMIN_PASSWORD_HASH line to paste here
# Keep the single quotes around the hash. In a docker-compose .env file write each $ as $$.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD_HASH='$2b$12$...'
# ADMIN_SESSION_HOURS=12

# Off-site backups (any S3-compatible storage: Cloudflare R2, Backblaze B2, AWS S3).
# `npm run backup` uploads a gzipped snapshot when BACKUP_S3_BUCKET is set.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=agrovet/
# BACKUP_S3_PATH_STYLE=false
# KEEP_REMOTE=30
